# Copy to .env and adjust. No real secrets belong in this file.

# API server
PORT=3000

# Product data source (only the server's Fake Store adapter uses this)
FAKE_STORE_BASE_URL=https://fakestoreapi.com

# Email (E4). Mailpit catches all mail locally: UI at http://localhost:8025
# Use SMTP_HOST=mailpit when running under Docker Compose.
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=no-reply@example.com
SALES_INBOX_EMAIL=sales@example.com
